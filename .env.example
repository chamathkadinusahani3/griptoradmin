# Copy to .env.local (already gitignored via the *.local rule) and fill in real values.

# MongoDB Atlas (or self-hosted) connection string, e.g.:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/griptor?retryWrites=true&w=majority
MONGODB_URI=

# Any long random string — used to sign session JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# PayHere (https://www.payhere.lk — Sri Lanka's payment gateway; Stripe was
# tried first but doesn't support Sri Lankan merchant accounts). From your
# PayHere Merchant account (sandbox: https://sandbox.payhere.lk). Powers
# real online payment of a garage's CustomerInvoices.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# "sandbox" or "live" — picks which of PayHere's two checkout endpoints to
# use. Defaults to "sandbox" if unset.
PAYHERE_MODE=sandbox

# Shared secret for the daily cron job (api/_lib/routes/cron/daily.ts) —
# Vercel auto-sends this as `Authorization: Bearer <value>` on its own
# scheduled invocations once set in the project's env vars. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
