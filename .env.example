# Copy to .env.local (already gitignored via the *.local rule) and fill in real values.

# MongoDB Atlas (or self-hosted) connection string, e.g.:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/griptor?retryWrites=true&w=majority
MONGODB_URI=

# Any long random string — used to sign session JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
